FROM registry.cn-hangzhou.aliyuncs.com/chatwiki/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i s/archive.ubuntu.com/mirrors.aliyun.com/g /etc/apt/sources.list  \
    && sed -i s/security.ubuntu.com/mirrors.aliyun.com/g /etc/apt/sources.list  \
    && apt update \
    && apt install supervisor -y \
    && apt install -y ca-certificates curl && update-ca-certificates \
    && curl -fsSL https://nginx.org/keys/nginx_signing.key -o /usr/share/keyrings/nginx-archive-keyring.asc \
    && echo 'deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.asc,573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62,8540A6F18833A80E9C1653A42FD21310B49F6B46]' \
        'https://nginx.org/packages/mainline/ubuntu jammy nginx' > /etc/apt/sources.list.d/nginx.list \
    && apt update \
    && apt install -y nginx=1.31.9-1~jammy \
    && sed -i -E 's/^user[[:space:]]+nginx;/user www-data;/' /etc/nginx/nginx.conf \
    && sed -i -E '/^[[:space:]]*listen[[:space:]]+80;/a\    listen [::]:80;' /etc/nginx/conf.d/default.conf

RUN apt install tzdata

COPY go_core/chatwiki.conf /etc/supervisor/conf.d/
COPY nginx/*.conf /etc/nginx/conf.d/